# URL pública da aplicação
BETTER_AUTH_URL=http://localhost:3000
# Segredo para assinar sessões (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
BETTER_AUTH_SECRET=

# Banco. Vazio = PGlite local em .data/pglite (desenvolvimento).
# Produção: string de conexão Postgres (Supabase, Neon...). Ex.: postgres://user:pass@host:5432/db
DATABASE_URL=

# E-mail (recuperação de senha). Vazio = mensagens aparecem no terminal.
RESEND_API_KEY=
MAIL_FROM="Focus <nao-responda@seudominio.com>"

# Rota de manutenção /api/cron/maintenance
CRON_SECRET=

# Chave do HMAC de identidade (CPF e matrícula). Mínimo 32 caracteres, aleatória.
# NUNCA troque depois de ter usuários: o mesmo CPF passaria a gerar outro código e a regra
# "uma conta por CPF" deixaria de funcionar. Guarde com backup seguro.
IDENTITY_HMAC_SECRET=

# Verificação de CPF + nascimento na Receita (CPFHub.io, Consulta em Tempo Real).
# Sem chave: em desenvolvimento valida só os dígitos; em produção nenhum CPF é vinculado.
CPFHUB_API_KEY=
